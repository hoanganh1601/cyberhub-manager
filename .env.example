# HA-01: sao chép thành .env và điền giá trị local; không commit .env thật.

# MySQL connection used by the desktop application
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=cyberhub_manager
MYSQL_USER=cyberhub_app
MYSQL_PASSWORD=change_me

# Used only when MySQL initializes a new Docker volume
MYSQL_ROOT_PASSWORD=change_root_me

# Application logging
LOG_LEVEL=INFO

# Browser server: export these in your shell or set them in the hosting dashboard.
# Modes: demo (temporary per-login data) or mysql (existing real services).
# CYBERHUB_WEB_MODE=demo
# CYBERHUB_SECRET_KEY=<generate-a-random-secret-at-least-32-characters>
# CYBERHUB_COOKIE_SECURE=true
# CYBERHUB_TRUST_PROXY=true
# CYBERHUB_ALLOWED_HOSTS=your-app.onrender.com
# RBAC: keep legacy until ADMIN/DIRECTOR account mapping is reviewed.
# After migration 025 and creating a separate DIRECTOR account, set separated.
# CYBERHUB_RBAC_POLICY=legacy
# Keep enabled in production. For local manual login testing only, set false.
# CYBERHUB_LOGIN_RATE_LIMIT_ENABLED=true
# CYBERHUB_LOGIN_RATE_LIMIT_ATTEMPTS=10
# CYBERHUB_LOGIN_RATE_LIMIT_WINDOW_SECONDS=600

# Counter customer registration and email activation (MySQL + separated RBAC only).
# A stable signing secret is required; never reuse or commit a real value.
# CYBERHUB_EMAIL_TOKEN_SECRET=<random-secret-at-least-32-characters>
# CYBERHUB_EMAIL_TOKEN_MINUTES=30
# CYBERHUB_PUBLIC_URL=https://your-app.example
# CYBERHUB_SMTP_HOST=smtp.gmail.com
# CYBERHUB_SMTP_PORT=465
# CYBERHUB_SMTP_USERNAME=your-email@example.com
# CYBERHUB_SMTP_PASSWORD=<smtp-app-password>
# CYBERHUB_SMTP_FROM=CyberHub <your-email@example.com>
# Run the committed outbox worker separately: python -m scripts.run_customer_email_worker

# Offline forecasting dashboard. Generate files with scripts.run_forecasting.
# CYBERHUB_FORECAST_DIR=D:/private/cyberhub-runtime/forecasting

# POS stock hold (new orders only); run scripts.run_pos_maintenance separately in MySQL mode.
# CYBERHUB_POS_HOLD_MINUTES=15

# AI assistant uses Gemini API (no local model/GPU needed):
# Put your own key in .env, then run:
# python -m scripts.run_rag_gemini --port 8059
# Create a key: https://aistudio.google.com/api-keys
# Free-tier requests send knowledge/questions/context to Google; quotas apply.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.1-flash-lite
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# CYBERHUB_GEMINI_MIN_SIMILARITY=0.6
# For python -m cyberhub_manager.web or hosted WSGI, also configure:
# CYBERHUB_ASSISTANT_ENABLED=true
# CYBERHUB_ASSISTANT_PROVIDER=gemini
# CYBERHUB_ASSISTANT_AUDIT_PATH=D:/private/cyberhub-ai-runtime/assistant/audit.sqlite3
