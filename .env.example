# HA-01: sao chép thành .env và điền giá trị local; không commit .env thật.

# MySQL connection used by the desktop application
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=cyberhub_manager
MYSQL_USER=cyberhub_app
MYSQL_PASSWORD=change_me

# Used only when MySQL initializes a new Docker volume
MYSQL_ROOT_PASSWORD=change_root_me

# Application logging
LOG_LEVEL=INFO

# Browser server: export these in your shell or set them in the hosting dashboard.
# Modes: demo (temporary per-login data) or mysql (existing real services).
# CYBERHUB_WEB_MODE=demo
# CYBERHUB_SECRET_KEY=<generate-a-random-secret-at-least-32-characters>
# CYBERHUB_COOKIE_SECURE=true
# CYBERHUB_TRUST_PROXY=true
# CYBERHUB_ALLOWED_HOSTS=your-app.onrender.com
