// Phiếu sự cố và vòng đời bảo trì máy từ báo lỗi đến nghiệm thu.
// DDL: sql/022_machine_incidents.sql
// CHECK chk_incidents_cost: ((labor_cost <= 1000000000) and (parts_cost <= 1000000000))
// CHECK chk_incidents_severity: (severity in ('LOW','MEDIUM','HIGH','CRITICAL'))
// CHECK chk_incidents_status: (status in ('REPORTED','ASSIGNED','IN_PROGRESS','WAITING_PARTS','COMPLETED','VERIFIED','CANCELLED'))
Table machine_incidents {
  id bigint [not null, pk, increment]
  code varchar(24) [not null]
  store_id bigint [not null]
  machine_id bigint [not null]
  reported_by bigint [not null]
  assigned_to bigint
  severity varchar(10) [not null]
  status varchar(20) [not null, default: 'REPORTED']
  title varchar(120) [not null]
  description varchar(1000) [not null]
  resolution varchar(1000)
  labor_cost bigint [not null, default: 0]
  parts_cost bigint [not null, default: 0]
  reported_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  started_at datetime
  completed_at datetime
  verified_at datetime
  verified_by bigint

  indexes {
  (code) [unique, name: 'uq_machine_incidents_code']
  (machine_id, reported_at, id) [name: 'idx_incidents_machine_history']
  (store_id, status, reported_at) [name: 'idx_incidents_store_status']
  }
}

// Linh kiện sử dụng cho một phiếu sửa máy.
// DDL: sql/022_machine_incidents.sql
// CHECK chk_incident_parts_cost: (unit_cost <= 1000000000)
// CHECK chk_incident_parts_quantity: (quantity between 1 and 1000)
Table machine_incident_parts {
  id bigint [not null, pk, increment]
  incident_id bigint [not null]
  name varchar(120) [not null]
  quantity int [not null]
  unit_cost bigint [not null]
}

// Lịch sử chuyển trạng thái sự cố máy, chỉ thêm.
// DDL: sql/022_machine_incidents.sql
Table machine_incident_events {
  id bigint [not null, pk, increment]
  incident_id bigint [not null]
  employee_id bigint [not null]
  from_status varchar(20)
  to_status varchar(20) [not null]
  note varchar(500) [not null, default: '']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
  (incident_id, created_at, id) [name: 'idx_incident_events_history']
  }
}

// Nhà cung cấp theo cơ sở và điều khoản thanh toán.
// DDL: sql/023_procurement.sql
// CHECK chk_suppliers_terms: (payment_terms_days <= 365)
Table suppliers {
  id bigint [not null, pk, increment]
  store_id bigint [not null]
  code varchar(24) [not null]
  name varchar(120) [not null]
  phone varchar(20)
  email varchar(120)
  address varchar(255)
  payment_terms_days int [not null, default: 0]
  is_active tinyint(1) [not null, default: 1]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
  (store_id, code) [unique, name: 'uq_suppliers_store_code']
  }
}

// Đề nghị nhập hàng có người lập và người quyết định.
// DDL: sql/023_procurement.sql
// CHECK chk_purchase_requests_decision: (((status = 'PENDING') and (decided_by is null) and (decided_at is null)) or ((status <> 'PENDING') and (decided_by is not null) and (decided_at is not null)))
// CHECK chk_purchase_requests_status: (status in ('PENDING','APPROVED','REJECTED','ORDERED'))
Table purchase_requests {
  id bigint [not null, pk, increment]
  code varchar(24) [not null]
  store_id bigint [not null]
  requested_by bigint [not null]
  status varchar(12) [not null, default: 'PENDING']
  reason varchar(255) [not null]
  decided_by bigint
  decided_at datetime
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
  (code) [unique, name: 'uq_purchase_requests_code']
  }
}

// Nguyên liệu và số lượng trong đề nghị nhập.
// DDL: sql/023_procurement.sql
// CHECK chk_purchase_request_lines_quantity: (quantity > 0)
Table purchase_request_lines {
  request_id bigint [not null]
  ingredient_id bigint [not null]
  quantity bigint [not null]

  indexes {
  (request_id, ingredient_id) [pk]
  }
}

// Đơn mua hàng tạo từ đề nghị đã duyệt và gắn nhà cung cấp.
// DDL: sql/023_procurement.sql
// CHECK chk_purchase_orders_status: (status in ('OPEN','PARTIALLY_RECEIVED','RECEIVED','CANCELLED'))
// CHECK chk_purchase_orders_total: (total_amount > 0)
Table purchase_orders {
  id bigint [not null, pk, increment]
  code varchar(24) [not null]
  store_id bigint [not null]
  request_id bigint [not null]
  supplier_id bigint [not null]
  created_by bigint [not null]
  status varchar(20) [not null, default: 'OPEN']
  ordered_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  expected_at datetime
  total_amount bigint [not null]

  indexes {
  (code) [unique, name: 'uq_purchase_orders_code']
  (request_id) [unique, name: 'uq_purchase_orders_request']
  }
}

// Dòng đơn mua và tiến độ nhận theo nguyên liệu.
// DDL: sql/023_procurement.sql
// CHECK chk_purchase_order_lines_quantity: ((quantity > 0) and (unit_cost > 0))
// CHECK chk_purchase_order_lines_received: ((received_quantity + damaged_quantity) <= quantity)
Table purchase_order_lines {
  order_id bigint [not null]
  ingredient_id bigint [not null]
  quantity bigint [not null]
  unit_cost bigint [not null]
  received_quantity bigint [not null, default: 0]
  damaged_quantity bigint [not null, default: 0]

  indexes {
  (order_id, ingredient_id) [pk]
  }
}

// Phiếu nhận hàng idempotent, tạo nhập kho và công nợ theo số lượng đạt.
// DDL: sql/023_procurement.sql
Table goods_receipts {
  id bigint [not null, pk, increment]
  code varchar(24) [not null]
  order_id bigint [not null]
  store_id bigint [not null]
  received_by bigint [not null]
  request_id char(32) [not null]
  note varchar(255) [not null, default: '']
  received_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  accepted_amount bigint [not null]

  indexes {
  (code) [unique, name: 'uq_goods_receipts_code']
  (request_id) [unique, name: 'uq_goods_receipts_request']
  }
}

// Chi tiết hàng đạt, hỏng và thiếu trong một lần nhận.
// DDL: sql/023_procurement.sql
// CHECK chk_goods_receipt_lines_quantity: (((accepted_quantity + damaged_quantity) + missing_quantity) > 0)
Table goods_receipt_lines {
  receipt_id bigint [not null]
  ingredient_id bigint [not null]
  accepted_quantity bigint [not null]
  damaged_quantity bigint [not null, default: 0]
  missing_quantity bigint [not null, default: 0]
  unit_cost bigint [not null]

  indexes {
  (receipt_id, ingredient_id) [pk]
  }
}

// Công nợ phát sinh từ phiếu nhận hàng và trạng thái thanh toán.
// DDL: sql/023_procurement.sql
// CHECK chk_supplier_payables_amount: ((amount > 0) and (paid_amount <= amount))
// CHECK chk_supplier_payables_method: ((payment_method is null) or (payment_method in ('CASH','TRANSFER')))
// CHECK chk_supplier_payables_status: (status in ('UNPAID','PAID'))
Table supplier_payables {
  id bigint [not null, pk, increment]
  receipt_id bigint [not null]
  supplier_id bigint [not null]
  store_id bigint [not null]
  amount bigint [not null]
  paid_amount bigint [not null, default: 0]
  due_date date [not null]
  status varchar(10) [not null, default: 'UNPAID']
  paid_at datetime
  paid_by bigint
  payment_method varchar(10)

  indexes {
  (receipt_id) [unique, name: 'uq_supplier_payables_receipt']
  (store_id, status, due_date) [name: 'idx_supplier_payables_due']
  }
}

// Đối tác cung cấp game hoặc mạng quảng cáo.
// DDL: sql/024_commercial_partners.sql
// CHECK chk_commercial_partners_status: (status in ('ACTIVE','SUSPENDED','TERMINATED'))
// CHECK chk_commercial_partners_type: (partner_type in ('GAME','AD_NETWORK','BOTH'))
Table commercial_partners {
  id bigint [not null, pk, increment]
  code varchar(24) [not null]
  name varchar(120) [not null]
  partner_type varchar(12) [not null]
  status varchar(12) [not null, default: 'ACTIVE']
  callback_secret_ref varchar(80)
  contact_name varchar(100)
  contact_email varchar(120)
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`] // ON UPDATE CURRENT_TIMESTAMP

  indexes {
  (code) [unique, name: 'uq_commercial_partners_code']
  }
}

// Hợp đồng thương mại có maker-checker và mô hình tính doanh thu.
// DDL: sql/024_commercial_partners.sql
// CHECK chk_commercial_contracts_approval: (((status = 'DRAFT') and (approved_by is null) and (approved_at is null)) or ((status <> 'DRAFT') and (approved_by is not null) and (approved_at is not null)))
// CHECK chk_commercial_contracts_currency: (currency = 'VND')
// CHECK chk_commercial_contracts_model: (revenue_model in ('CPM','CPC','CPA','FIXED'))
// CHECK chk_commercial_contracts_period: (ends_on >= starts_on)
// CHECK chk_commercial_contracts_status: (status in ('DRAFT','ACTIVE','SUSPENDED','EXPIRED','TERMINATED'))
Table commercial_contracts {
  id bigint [not null, pk, increment]
  partner_id bigint [not null]
  code varchar(24) [not null]
  status varchar(12) [not null, default: 'DRAFT']
  revenue_model varchar(8) [not null]
  rate_amount bigint [not null]
  currency char(3) [not null, default: 'VND']
  starts_on date [not null]
  ends_on date [not null]
  created_by bigint [not null]
  approved_by bigint
  approved_at datetime
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
  (code) [unique, name: 'uq_commercial_contracts_code']
  }
}

// Chiến dịch game/quảng cáo thuộc một hợp đồng đã duyệt.
// DDL: sql/024_commercial_partners.sql
// CHECK chk_commercial_campaigns_kind: (kind in ('AD','GAME'))
// CHECK chk_commercial_campaigns_period: (ends_at > starts_at)
// CHECK chk_commercial_campaigns_reward: (((reward_type = 'NONE') and (reward_amount = 0)) or ((reward_type in ('COINS','VOUCHER','EXTRA_SPIN')) and (reward_amount > 0)))
// CHECK chk_commercial_campaigns_status: (status in ('DRAFT','ACTIVE','PAUSED','ENDED'))
Table commercial_campaigns {
  id bigint [not null, pk, increment]
  contract_id bigint [not null]
  code varchar(24) [not null]
  name varchar(120) [not null]
  kind varchar(8) [not null]
  status varchar(10) [not null, default: 'DRAFT']
  starts_at datetime [not null]
  ends_at datetime [not null]
  budget_amount bigint
  reward_type varchar(12) [not null, default: 'NONE']
  reward_amount int [not null, default: 0]
  created_by bigint [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
  (code) [unique, name: 'uq_commercial_campaigns_code']
  }
}

// Vị trí phát game/quảng cáo, có thể giới hạn theo cửa hàng.
// DDL: sql/024_commercial_partners.sql
// CHECK chk_commercial_placements_embed: (((placement_type = 'GAME') and (embed_url is not null) and (allowed_origin is not null)) or (placement_type = 'AD'))
// CHECK chk_commercial_placements_status: (status in ('ACTIVE','INACTIVE'))
// CHECK chk_commercial_placements_surface: (surface in ('PORTAL_BANNER','REWARDED_AD','GAME_CENTER'))
// CHECK chk_commercial_placements_type: (placement_type in ('AD','GAME'))
Table commercial_placements {
  id bigint [not null, pk, increment]
  campaign_id bigint [not null]
  store_id bigint
  code varchar(32) [not null]
  placement_type varchar(8) [not null]
  surface varchar(24) [not null]
  embed_url varchar(500)
  allowed_origin varchar(255)
  sandbox_policy varchar(120) [not null, default: 'allow-scripts allow-pointer-lock']
  legacy_game_id bigint
  legacy_ad_creative_id bigint
  status varchar(10) [not null, default: 'ACTIVE']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
  (code) [unique, name: 'uq_commercial_placements_code']
  (store_id, status) [name: 'idx_commercial_placements_store']
  }
}

// Phiên chơi ngoài có token một lần và hạn sử dụng.
// DDL: sql/024_commercial_partners.sql
// CHECK chk_commercial_play_sessions_period: (expires_at > issued_at)
// CHECK chk_commercial_play_sessions_reward: (((reward_type = 'NONE') and (reward_amount = 0)) or ((reward_type in ('COINS','VOUCHER','EXTRA_SPIN')) and (reward_amount > 0)))
// CHECK chk_commercial_play_sessions_status: (status in ('ISSUED','COMPLETED','EXPIRED','REJECTED'))
Table commercial_play_sessions {
  id bigint [not null, pk, increment]
  placement_id bigint [not null]
  account_id bigint [not null]
  token_hash char(64) [not null]
  status varchar(10) [not null, default: 'ISSUED']
  reward_type varchar(12) [not null]
  reward_amount int [not null]
  issued_at datetime [not null]
  expires_at datetime [not null]
  completed_at datetime

  indexes {
  (token_hash) [unique, name: 'uq_commercial_play_sessions_token']
  (account_id, status, issued_at) [name: 'idx_commercial_play_sessions_account']
  }
}

// Sổ sự kiện impression/start/complete/click, chống ghi trùng.
// DDL: sql/024_commercial_partners.sql
// CHECK chk_commercial_events_complete: ((event_type <> 'COMPLETE') or (verification_method in ('SERVER','SSV')))
// CHECK chk_commercial_events_type: (event_type in ('IMPRESSION','START','COMPLETE','CLICK'))
// CHECK chk_commercial_events_verification: (verification_method in ('CLIENT','SERVER','SSV'))
// CHECK chk_commercial_events_verified: (((verification_method = 'CLIENT') and (verified_at is null)) or ((verification_method in ('SERVER','SSV')) and (verified_at is not null)))
Table commercial_events {
  id bigint [not null, pk, increment]
  placement_id bigint [not null]
  campaign_id bigint [not null]
  play_session_id bigint
  account_id bigint
  event_type varchar(10) [not null]
  event_key varchar(80) [not null]
  provider_event_id varchar(100)
  verification_method varchar(8) [not null]
  accepted tinyint(1) [not null, default: 1]
  occurred_at datetime [not null]
  verified_at datetime
  payload_digest char(64)
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
  (event_key) [unique, name: 'uq_commercial_events_key']
  (provider_event_id) [unique, name: 'uq_commercial_events_provider']
  (campaign_id, event_type, accepted, occurred_at) [name: 'idx_commercial_events_campaign']
  }
}

// Outbox phần thưởng; callback không được cộng xu/phát voucher trực tiếp.
// DDL: sql/024_commercial_partners.sql
// CHECK chk_commercial_reward_grants_reward: ((reward_type in ('COINS','VOUCHER','EXTRA_SPIN')) and (reward_amount > 0))
// CHECK chk_commercial_reward_grants_status: (status in ('PENDING','APPLIED','FAILED'))
Table commercial_reward_grants {
  id bigint [not null, pk, increment]
  event_id bigint [not null]
  account_id bigint [not null]
  reward_type varchar(12) [not null]
  reward_amount int [not null]
  status varchar(10) [not null, default: 'PENDING']
  attempts int [not null, default: 0]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  applied_at datetime
  failure_reason varchar(255)

  indexes {
  (event_id) [unique, name: 'uq_commercial_reward_grants_event']
  (status, created_at) [name: 'idx_commercial_reward_grants_pending']
  }
}

// Kỳ đối soát doanh thu có maker-checker.
// DDL: sql/024_commercial_partners.sql
// CHECK chk_commercial_settlements_adjustment: (((adjustment_amount = 0) and (adjustment_reason is null)) or ((adjustment_amount <> 0) and (char_length(trim(adjustment_reason)) >= 5)))
// CHECK chk_commercial_settlements_amount: (net_amount = (gross_amount + adjustment_amount))
// CHECK chk_commercial_settlements_period: (period_end >= period_start)
// CHECK chk_commercial_settlements_status: (status in ('DRAFT','APPROVED','PAID','VOID'))
Table commercial_settlements {
  id bigint [not null, pk, increment]
  contract_id bigint [not null]
  period_start date [not null]
  period_end date [not null]
  gross_amount bigint [not null]
  adjustment_amount bigint [not null, default: 0]
  adjustment_reason varchar(255)
  net_amount bigint [not null]
  status varchar(10) [not null, default: 'DRAFT']
  generated_by bigint [not null]
  reviewed_by bigint
  reviewed_at datetime
  paid_at datetime
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
  (contract_id, period_start, period_end) [unique, name: 'uq_commercial_settlements_period']
  }
}

// Dòng snapshot đối soát theo vị trí và loại sự kiện.
// DDL: sql/024_commercial_partners.sql
// CHECK chk_commercial_settlement_lines_event: (event_type in ('IMPRESSION','CLICK','COMPLETE','FIXED'))
Table commercial_settlement_lines {
  settlement_id bigint [not null]
  placement_id bigint [not null]
  event_type varchar(10) [not null]
  units bigint [not null]
  unit_rate bigint [not null]
  amount bigint [not null]

  indexes {
  (settlement_id, placement_id, event_type) [pk]
  }
}

// Bản ghi duyệt công nợ nhà cung cấp; dùng kiểm soát phân tách người duyệt và người chi.
// DDL: sql/026_rbac_operational_boundaries.sql
Table supplier_payable_approvals {
  payable_id bigint [not null, pk]
  approved_by bigint [not null]
  approved_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  note varchar(255) [not null]
}

// Token kích hoạt/đặt lại mật khẩu khách; chỉ lưu hash và nonce dẫn xuất, token thô không được lưu.
// DDL: sql/027_customer_email_activation.sql
// CHECK chk_customer_email_token_purpose: (purpose in ('ACTIVATE','RESET'))
Table customer_email_tokens {
  id bigint [not null, pk, increment]
  account_id bigint [not null]
  purpose varchar(12) [not null]
  token_hash char(64) [not null]
  nonce char(64) [not null]
  expires_at datetime [not null]
  used_at datetime
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
  (token_hash) [unique, name: 'uq_customer_email_token_hash']
  (account_id, purpose, created_at) [name: 'idx_customer_email_token_account']
  }
}

// Transactional outbox gửi email khách sau khi transaction đăng ký/reset đã commit.
// DDL: sql/027_customer_email_activation.sql
// CHECK chk_customer_mail_outbox_status: (status in ('PENDING','SENDING','SENT','FAILED'))
Table customer_mail_outbox {
  id bigint [not null, pk, increment]
  token_id bigint [not null]
  status varchar(12) [not null, default: 'PENDING']
  attempts int [not null, default: 0]
  next_attempt_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  sent_at datetime
  last_error varchar(120)

  indexes {
  (token_id) [unique, name: 'uq_customer_mail_outbox_token']
  (status, next_attempt_at) [name: 'idx_customer_mail_outbox_due']
  }
}

// Audit bất biến cho thao tác kích hoạt, đặt lại mật khẩu và các sự kiện bảo mật khách.
// DDL: sql/027_customer_email_activation.sql
Table customer_security_audit {
  id bigint [not null, pk, increment]
  account_id bigint [not null]
  employee_id bigint
  store_id bigint
  action varchar(40) [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
}

Ref fk_employees_store: employees.store_id > stores.id // ON UPDATE RESTRICT ON DELETE RESTRICT
Ref fk_employee_profiles_employee: employee_profiles.employee_id > employees.id // ON UPDATE NO ACTION ON DELETE NO ACTION
Ref fk_employee_profiles_store: employee_profiles.home_store_id > stores.id // ON UPDATE NO ACTION ON DELETE NO ACTION
Ref fk_employee_assignments_employee: employee_store_assignments.employee_id > employees.id // ON UPDATE NO ACTION ON DELETE NO ACTION
Ref fk_employee_assignments_granter: employee_store_assignments.granted_by > employees.id // ON UPDATE NO ACTION ON DELETE NO ACTION
Ref fk_employee_assignments_store: employee_store_assignments.store_id > stores.id // ON UPDATE NO ACTION ON DELETE NO ACTION
Ref fk_customer_links_customer: customer_store_links.customer_id > customers.id // ON UPDATE NO ACTION ON DELETE NO ACTION
Ref fk_customer_links_store: customer_store_links.store_id > stores.id // ON UPDATE NO ACTION ON DELETE NO ACTION
Ref fk_accounts_customer: accounts.customer_id > customers.id // ON UPDATE RESTRICT ON DELETE RESTRICT
Ref fk_machines_store: machines.store_id > stores.id // ON UPDATE RESTRICT ON DELETE RESTRICT
Ref fk_usage_sessions_closed_by: usage_sessions.closed_by > employees.id // ON UPDATE RESTRICT ON DELETE RESTRICT
Ref fk_usage_sessions_customer: usage_sessions.customer_id > customers.id // ON UPDATE RESTRICT ON DELETE RESTRICT
Ref fk_usage_sessions_machine: usage_sessions.machine_id > machines.id // ON UPDATE RESTRICT ON DELETE RESTRICT
Ref fk_usage_sessions_opened_by: usage_sessions.opened_by > employees.id // ON UPDATE RESTRICT ON DELETE RESTRICT
Ref fk_account_transactions_account: account_transactions.account_id > accounts.id // ON UPDATE RESTRICT ON DELETE RESTRICT
Ref fk_account_transactions_employee: account_transactions.employee_id > employees.id // ON UPDATE RESTRICT ON DELETE RESTRICT
Ref fk_account_transactions_session: account_transactions.session_id > usage_sessions.id // ON UPDATE RESTRICT ON DELETE RESTRICT
Ref fk_transactions_promotion: account_transactions.promotion_id > promotions.id // ON UPDATE NO ACTION ON DELETE RESTRICT
Ref fk_transactions_store: account_transactions.store_id > stores.id // ON UPDATE NO ACTION ON DELETE RESTRICT
Ref fk_invoices_customer: invoices.customer_id > customers.id // ON UPDATE RESTRICT ON DELETE RESTRICT
Ref fk_invoices_employee: invoices.employee_id > employees.id // ON UPDATE RESTRICT ON DELETE RESTRICT
Ref fk_invoices_session: invoices.session_id > usage_sessions.id // ON UPDATE RESTRICT ON DELETE RESTRICT
Ref fk_invoices_store: invoices.store_id > stores.id // ON UPDATE RESTRICT ON DELETE RESTRICT
Ref fk_promotion_target_customer: promotions.target_customer_id > customers.id // ON UPDATE NO ACTION ON DELETE RESTRICT
Ref fk_promotions_store: promotions.store_id > stores.id // ON UPDATE NO ACTION ON DELETE RESTRICT
Ref fk_management_audit_employee: management_audit.employee_id > employees.id // ON UPDATE NO ACTION ON DELETE RESTRICT
Ref fk_management_audit_store: management_audit.store_id > stores.id // ON UPDATE NO ACTION ON DELETE RESTRICT
Ref fk_customer_notification_account: customer_notification_reads.account_id > accounts.id // ON UPDATE NO ACTION ON DELETE RESTRICT
Ref fk_machine_room_machine: machine_room_types.machine_id > machines.id // ON UPDATE RESTRICT ON DELETE CASCADE
Ref fk_customer_avatar_account: customer_avatars.account_id > accounts.id // ON UPDATE NO ACTION ON DELETE CASCADE
Ref fk_menu_categories_store: menu_categories.store_id > stores.id // ON UPDATE RESTRICT ON DELETE RESTRICT
Ref fk_menu_items_category: menu_items.category_id > menu_categories.id // ON UPDATE RESTRICT ON DELETE RESTRICT
Ref fk_menu_items_store: menu_items.store_id > stores.id // ON UPDATE RESTRICT ON DELETE RESTRICT
Ref fk_menu_item_images_item: menu_item_images.item_id > menu_items.id // ON UPDATE RESTRICT ON DELETE RESTRICT
