// CyberHub Manager — DBML sinh từ docs/diagrams/data_dictionary.md.
// Dictionary phản ánh schema MySQL sau các migration 001–027.
// Bảng schema_migrations do migration runner tạo riêng nên không nằm trong 70 bảng nghiệp vụ.

// Cửa hàng net. Nhân viên, máy và hóa đơn đều thuộc một cửa hàng.
// DDL: sql/001_initial_schema.sql
// CHECK chk_stores_address_not_blank: (char_length(trim(address)) > 0)
// CHECK chk_stores_code_not_blank: (char_length(trim(code)) > 0)
// CHECK chk_stores_name_not_blank: (char_length(trim(name)) > 0)
// CHECK chk_stores_status: (status in ('ACTIVE','INACTIVE'))
Table stores {
  id bigint [not null, pk, increment]
  code varchar(20) [not null]
  name varchar(100) [not null]
  address varchar(255) [not null]
  status varchar(20) [not null, default: 'ACTIVE']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`] // ON UPDATE CURRENT_TIMESTAMP

  indexes {
  (code) [unique, name: 'uq_stores_code']
  }
}

// Nhân viên đăng nhập ứng dụng; vai trò quyết định quyền thao tác.
// DDL: sql/001_initial_schema.sql
// CHECK chk_employees_code_not_blank: (char_length(trim(code)) > 0)
// CHECK chk_employees_full_name_not_blank: (char_length(trim(full_name)) > 0)
// CHECK chk_employees_password_hash_not_blank: (char_length(trim(password_hash)) > 0)
// CHECK chk_employees_role: (role in ('ADMIN','DIRECTOR','MANAGER','STAFF','KITCHEN','INVENTORY'))
// CHECK chk_employees_status: (status in ('ACTIVE','INACTIVE','LOCKED'))
// CHECK chk_employees_username_length: (char_length(username) between 4 and 30)
Table employees {
  id bigint [not null, pk, increment]
  code varchar(20) [not null]
  store_id bigint [not null]
  full_name varchar(100) [not null]
  username varchar(30) [not null]
  password_hash varchar(255) [not null]
  role varchar(20) [not null]
  status varchar(20) [not null, default: 'ACTIVE']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`] // ON UPDATE CURRENT_TIMESTAMP
  auth_version int [not null, default: 0]
  must_change_password tinyint(1) [not null, default: 0]
  password_changed_at datetime

  indexes {
  (code) [unique, name: 'uq_employees_code']
  (username) [unique, name: 'uq_employees_username']
  (store_id, status) [name: 'idx_employees_store_status']
  }
}

// Hồ sơ nhân sự độc lập với thông tin xác thực; DIRECTOR/MANAGER quản lý nghiệp vụ, ADMIN chỉ gắn/cấp tài khoản.
// DDL: sql/026_rbac_operational_boundaries.sql
// CHECK chk_employee_profiles_status: (employment_status in ('ACTIVE','INACTIVE'))
Table employee_profiles {
  id bigint [not null, pk, increment]
  employee_id bigint
  code varchar(20) [not null]
  home_store_id bigint [not null]
  full_name varchar(100) [not null]
  employment_status varchar(10) [not null, default: 'ACTIVE']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`] // ON UPDATE CURRENT_TIMESTAMP

  indexes {
  (code) [unique, name: 'uq_employee_profiles_code']
  (employee_id) [unique, name: 'uq_employee_profiles_employee']
  }
}

// Phân công bổ sung cho MANAGER được vận hành tại nhiều cơ sở; không thay đổi cơ sở chính trong hồ sơ.
// DDL: sql/026_rbac_operational_boundaries.sql
Table employee_store_assignments {
  employee_id bigint [not null]
  store_id bigint [not null]
  granted_by bigint [not null]
  granted_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
  (employee_id, store_id) [pk]
  }
}

// Thông tin cá nhân của khách chơi.
// DDL: sql/001_initial_schema.sql
// CHECK chk_customers_code_not_blank: (char_length(trim(code)) > 0)
// CHECK chk_customers_full_name_length: (char_length(trim(full_name)) between 2 and 100)
// CHECK chk_customers_phone_format: regexp_like(phone,'^0[0-9]{9}$','c')
// CHECK chk_customers_status: (status in ('ACTIVE','INACTIVE'))
Table customers {
  id bigint [not null, pk, increment]
  code varchar(20) [not null]
  full_name varchar(100) [not null]
  phone char(10) [not null]
  status varchar(20) [not null, default: 'ACTIVE']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`] // ON UPDATE CURRENT_TIMESTAMP
  email varchar(254)

  indexes {
  (code) [unique, name: 'uq_customers_code']
  (email) [unique, name: 'uq_customers_email']
  (phone) [unique, name: 'uq_customers_phone']
  (full_name) [name: 'idx_customers_full_name']
  }
}

// Phạm vi khách hàng tại từng cơ sở, suy ra từ giao dịch/phiên hoặc liên kết được xác minh tại quầy.
// DDL: sql/026_rbac_operational_boundaries.sql
Table customer_store_links {
  customer_id bigint [not null]
  store_id bigint [not null]
  source varchar(24) [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
  (customer_id, store_id) [pk]
  }
}

// Tài khoản đăng nhập máy trạm và ví tiền của khách; mỗi khách đúng một tài khoản.
// DDL: sql/001_initial_schema.sql
// CHECK chk_accounts_bonus_nonnegative: (bonus_balance >= 0)
// CHECK chk_accounts_code_not_blank: (char_length(trim(code)) > 0)
// CHECK chk_accounts_password_hash_not_blank: ((password_hash is null) or (char_length(trim(password_hash)) > 0))
// CHECK chk_accounts_status: (status in ('ACTIVE','LOCKED'))
// CHECK chk_accounts_username_format: regexp_like(username,'^[A-Za-z0-9_.]{4,30}$','c')
Table accounts {
  id bigint [not null, pk, increment]
  code varchar(20) [not null]
  customer_id bigint [not null]
  username varchar(30) [not null]
  password_hash varchar(255)
  balance bigint [not null, default: 0]
  status varchar(20) [not null, default: 'ACTIVE']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`] // ON UPDATE CURRENT_TIMESTAMP
  bonus_balance bigint [not null, default: 0]
  cash_balance bigint
  auth_version bigint [not null, default: 0]
  web_login_enabled tinyint(1) [not null, default: 1]
  email_verified_at datetime

  indexes {
  (code) [unique, name: 'uq_accounts_code']
  (customer_id) [unique, name: 'uq_accounts_customer']
  (username) [unique, name: 'uq_accounts_username']
  }
}

// Máy trạm của cửa hàng và trạng thái hiện tại.
// DDL: sql/001_initial_schema.sql
// CHECK chk_machines_archived_not_in_use: ((is_active = true) or (status <> 'IN_USE'))
// CHECK chk_machines_code_not_blank: (char_length(trim(code)) > 0)
// CHECK chk_machines_hourly_rate: (hourly_rate > 0)
// CHECK chk_machines_is_active: (is_active in (false,true))
// CHECK chk_machines_name_not_blank: (char_length(trim(name)) > 0)
// CHECK chk_machines_status: (status in ('AVAILABLE','IN_USE','MAINTENANCE'))
Table machines {
  id bigint [not null, pk, increment]
  code varchar(20) [not null]
  store_id bigint [not null]
  name varchar(100) [not null]
  status varchar(20) [not null, default: 'AVAILABLE']
  hourly_rate bigint [not null]
  is_active tinyint(1) [not null, default: 1]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`] // ON UPDATE CURRENT_TIMESTAMP

  indexes {
  (code) [unique, name: 'uq_machines_code']
  (store_id, is_active, status) [name: 'idx_machines_store_active_status']
  }
}

// Một lần khách dùng một máy, từ lúc mở đến lúc checkout.
// DDL: sql/001_initial_schema.sql
// CHECK chk_usage_sessions_code_not_blank: (char_length(trim(code)) > 0)
// CHECK chk_usage_sessions_cost: ((cost is null) or (cost >= 0))
// CHECK chk_usage_sessions_hourly_rate: (hourly_rate > 0)
// CHECK chk_usage_sessions_state: (((status = 'ACTIVE') and (ended_at is null) and (cost is null)) or ((status = 'COMPLETED') and (ended_at is not null) and (cost is not null)) or ((status = 'CANCELLED') and (ended_at is not null)))
// CHECK chk_usage_sessions_status: (status in ('ACTIVE','COMPLETED','CANCELLED'))
// CHECK chk_usage_sessions_time_order: ((ended_at is null) or (ended_at >= started_at))
Table usage_sessions {
  id bigint [not null, pk, increment]
  code varchar(20) [not null]
  customer_id bigint [not null]
  machine_id bigint [not null]
  opened_by bigint [not null]
  closed_by bigint
  started_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  ended_at datetime
  hourly_rate bigint [not null]
  cost bigint
  status varchar(20) [not null, default: 'ACTIVE']
  active_machine_id bigint
  active_customer_id bigint

  indexes {
  (active_customer_id) [unique, name: 'uq_usage_sessions_active_customer']
  (active_machine_id) [unique, name: 'uq_usage_sessions_active_machine']
  (code) [unique, name: 'uq_usage_sessions_code']
  (customer_id, started_at) [name: 'idx_usage_sessions_customer_started_at']
  (machine_id, started_at) [name: 'idx_usage_sessions_machine_started_at']
  (status, started_at) [name: 'idx_usage_sessions_status_started_at']
  }
}

// Sổ cái biến động số dư: mọi lần cộng/trừ `accounts.balance` đều có đúng một dòng; không sửa, không xóa.
// DDL: sql/001_initial_schema.sql
// CHECK chk_account_transactions_amount: (((type in ('TOP_UP','PROMOTION','DEBT_SETTLEMENT')) and (amount > 0)) or ((type = 'USAGE_PAYMENT') and (amount < 0)))
// CHECK chk_account_transactions_code_not_blank: (char_length(trim(code)) > 0)
// CHECK chk_account_transactions_method: (method in ('CASH','TRANSFER','ACCOUNT_BALANCE','PROMOTION'))
// CHECK chk_account_transactions_type: (type in ('TOP_UP','PROMOTION','USAGE_PAYMENT','DEBT_SETTLEMENT'))
// CHECK chk_account_transactions_type_method: (((type in ('TOP_UP','DEBT_SETTLEMENT')) and (method in ('CASH','TRANSFER'))) or ((type = 'USAGE_PAYMENT') and (method = 'ACCOUNT_BALANCE')) or ((type = 'PROMOTION') and (method = 'PROMOTION')))
Table account_transactions {
  id bigint [not null, pk, increment]
  code varchar(20) [not null]
  account_id bigint [not null]
  employee_id bigint [not null]
  session_id bigint
  type varchar(20) [not null]
  amount bigint [not null]
  method varchar(20) [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  store_id bigint
  promotion_id bigint

  indexes {
  (code) [unique, name: 'uq_account_transactions_code']
  (account_id, created_at) [name: 'idx_account_transactions_account_created_at']
  }
}

// Hóa đơn tạo khi checkout thành công; lưu lại khách, nhân viên, cửa hàng để giữ đúng lịch sử.
// DDL: sql/001_initial_schema.sql
// CHECK chk_invoice_loyalty: ((loyalty_eligible_amount >= 0) and (loyalty_points >= 0) and (loyalty_unit > 0))
// CHECK chk_invoices_bonus_used: ((bonus_used >= 0) and (bonus_used <= usage_cost))
// CHECK chk_invoices_code_not_blank: (char_length(trim(code)) > 0)
// CHECK chk_invoices_money: ((usage_cost >= 0) and (settlement_amount >= 0) and (total_amount >= 0))
// CHECK chk_invoices_settlement: (settlement_amount <= usage_cost)
// CHECK chk_invoices_status: (status in ('PAID','VOID'))
// CHECK chk_invoices_total: (total_amount = usage_cost)
Table invoices {
  id bigint [not null, pk, increment]
  code varchar(20) [not null]
  session_id bigint [not null]
  customer_id bigint [not null]
  employee_id bigint [not null]
  store_id bigint [not null]
  usage_cost bigint [not null]
  settlement_amount bigint [not null, default: 0]
  total_amount bigint [not null]
  status varchar(20) [not null, default: 'PAID']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  bonus_used bigint [not null, default: 0]
  loyalty_eligible_amount bigint [not null, default: 0]
  loyalty_points bigint [not null, default: 0]
  loyalty_unit bigint [not null, default: 10000]
  loyalty_rule_version int [not null, default: 1]

  indexes {
  (code) [unique, name: 'uq_invoices_code']
  (session_id) [unique, name: 'uq_invoices_session']
  (customer_id, created_at) [name: 'idx_invoices_customer_created_at']
  (store_id, status, created_at) [name: 'idx_invoices_store_status_created_at']
  }
}

// Chính sách thưởng theo mốc nạp, phạm vi và thời gian.
// DDL: sql/003_p1_management_wallet.sql
// CHECK chk_promotion_points: ((minimum_points >= 0) and (minimum_points <= 1000000000))
// CHECK chk_promotion_tier: (minimum_tier in ('BRONZE','SILVER','GOLD','PLATINUM'))
// CHECK chk_promotions_amount: ((minimum_amount > 0) and (minimum_amount <= 100000000))
// CHECK chk_promotions_percent: (bonus_percent between 0 and 100)
// CHECK chk_promotions_period: (ends_at > starts_at)
Table promotions {
  id bigint [not null, pk, increment]
  code varchar(20) [not null]
  name varchar(100) [not null]
  store_id bigint
  minimum_amount bigint [not null]
  bonus_percent int [not null]
  starts_at datetime [not null]
  ends_at datetime [not null]
  is_active tinyint(1) [not null, default: 1]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  minimum_tier varchar(10) [not null, default: 'BRONZE']
  minimum_points bigint [not null, default: 0]
  target_customer_id bigint

  indexes {
  (code) [unique, name: 'code']
  (store_id, is_active, minimum_amount) [name: 'ix_promotions_eligible']
  }
}

// Lịch sử thay đổi quản trị, không lưu mật khẩu.
// DDL: sql/003_p1_management_wallet.sql
Table management_audit {
  id bigint [not null, pk, increment]
  employee_id bigint [not null]
  store_id bigint [not null]
  action varchar(40) [not null]
  entity_id bigint [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
}

// Trạng thái đã đọc thông báo riêng của từng tài khoản khách; không thay đổi sổ tiền.
// DDL: sql/004_customer_notifications.sql
Table customer_notification_reads {
  account_id bigint [not null]
  notification_key varchar(100) [not null]
  read_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
  (account_id, notification_key) [pk]
  }
}

// Phân loại máy theo phòng thường/VIP; máy chưa gán thuộc phòng thường.
// DDL: sql/005_customer_phase2.sql
// CHECK chk_machine_room_type: (room_type in ('STANDARD','VIP','COUPLE','SUPER_VIP'))
Table machine_room_types {
  machine_id bigint [not null, pk]
  room_type varchar(10) [not null]
}

// Cấu hình toàn hệ thống, một dòng id=1; chỉ Admin được sửa, có version chống ghi đè.
// DDL: sql/006_customer_membership_avatar.sql
// CHECK chk_loyalty_singleton: (id = 1)
// CHECK chk_loyalty_tiers: ((silver_spend > 0) and (gold_spend > silver_spend) and (platinum_spend > gold_spend))
// CHECK chk_loyalty_unit: ((unit_amount > 0) and (unit_amount <= 100000000))
Table loyalty_settings {
  id tinyint [not null, pk]
  enabled tinyint(1) [not null, default: 1]
  unit_amount bigint [not null, default: 10000]
  silver_spend bigint [not null, default: 1000000]
  gold_spend bigint [not null, default: 3000000]
  platinum_spend bigint [not null, default: 5000000]
  version int [not null, default: 1]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`] // ON UPDATE CURRENT_TIMESTAMP
}

// Ảnh đại diện riêng theo tài khoản; WebP 512×512 đã chuẩn hóa, không giữ tên file hay metadata gốc.
// DDL: sql/006_customer_membership_avatar.sql
Table customer_avatars {
  account_id bigint [not null, pk]
  image_data mediumblob [not null]
  digest char(64) [not null]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`] // ON UPDATE CURRENT_TIMESTAMP
}

// Nhóm món theo cơ sở, xếp vào trang Đồ ăn (FOOD) hoặc Đồ uống (DRINK).
// DDL: sql/007_menu.sql
// CHECK chk_menu_categories_name: (char_length(trim(name)) > 0)
// CHECK chk_menu_categories_page: (page in ('FOOD','DRINK'))
// CHECK chk_menu_categories_sort: (sort_order between 0 and 9999)
Table menu_categories {
  id bigint [not null, pk, increment]
  store_id bigint [not null]
  page varchar(10) [not null]
  name varchar(60) [not null]
  sort_order int [not null, default: 0]
  is_active tinyint(1) [not null, default: 1]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
  (store_id, name) [unique, name: 'uq_menu_categories_store_name']
  (store_id, page, sort_order) [name: 'idx_menu_categories_store_page']
  }
}

// Món ăn/đồ uống của cơ sở; không xóa cứng, chỉ ẩn để giữ lịch sử gọi món.
// DDL: sql/007_menu.sql
// CHECK chk_menu_items_name: (char_length(trim(name)) > 0)
// CHECK chk_menu_items_price: (price between 1000 and 10000000)
// CHECK chk_menu_items_sort: (sort_order between 0 and 9999)
Table menu_items {
  id bigint [not null, pk, increment]
  store_id bigint [not null]
  category_id bigint [not null]
  name varchar(80) [not null]
  description varchar(200) [not null, default: '']
  price bigint [not null]
  sort_order int [not null, default: 0]
  is_visible tinyint(1) [not null, default: 1]
  is_available tinyint(1) [not null, default: 1]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`] // ON UPDATE CURRENT_TIMESTAMP
  is_stock_tracked tinyint(1) [not null, default: 0]

  indexes {
  (store_id, name) [unique, name: 'uq_menu_items_store_name']
  (store_id, category_id, sort_order) [name: 'idx_menu_items_store_category']
  }
}

// Ảnh món đã chuẩn hóa (WebP 512×512, không metadata).
// DDL: sql/007_menu.sql
Table menu_item_images {
  item_id bigint [not null, pk]
  image_data mediumblob [not null]
  digest char(64) [not null]
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`] // ON UPDATE CURRENT_TIMESTAMP
}

// Lịch sử thay đổi giá, tên, nhóm, ảnh và trạng thái bán; chỉ thêm, không sửa.
// DDL: sql/007_menu.sql
// CHECK chk_menu_item_changes_field: (field in ('CREATE','NAME','CATEGORY','PRICE','AVAILABLE','VISIBLE','IMAGE'))
Table menu_item_changes {
  id bigint [not null, pk, increment]
  item_id bigint [not null]
  employee_id bigint [not null]
  field varchar(20) [not null]
  old_value varchar(200)
  new_value varchar(200)
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
  (item_id, created_at) [name: 'idx_menu_item_changes_item']
  }
}

// Đơn POS đồ ăn/thức uống của khách đang chơi; thanh toán tại quầy, không trừ ví giờ chơi.
// DDL: sql/007_menu.sql
// CHECK chk_menu_orders_handled: (((status = 'NEW') and (handled_by is null)) or ((status = 'CANCELLED') and (handled_by is null) and (cancel_reason = 'AUTO_EXPIRED')) or ((status <> 'NEW') and (handled_by is not null)))
// CHECK chk_menu_orders_payment: (((status in ('PAID','REFUNDED')) and (payment_method in ('CASH','TRANSFER')) and (paid_at is not null) and (paid_by is not null)) or ((status not in ('PAID','REFUNDED')) and (payment_method is null) and (paid_at is null) and (paid_by is null)))
// CHECK chk_menu_orders_status: (status in ('NEW','PREPARING','SERVED','PAID','CANCELLED','REFUNDED'))
// CHECK chk_menu_orders_total: (total_amount > 0)
Table menu_orders {
  id bigint [not null, pk, increment]
  code varchar(20) [not null]
  store_id bigint [not null]
  account_id bigint [not null]
  session_id bigint [not null]
  machine_id bigint [not null]
  note varchar(200) [not null, default: '']
  total_amount bigint [not null]
  status varchar(12) [not null, default: 'NEW']
  handled_by bigint
  payment_method varchar(10)
  paid_at datetime
  paid_by bigint
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  reservation_expires_at datetime
  updated_at datetime [not null, default: `CURRENT_TIMESTAMP`] // ON UPDATE CURRENT_TIMESTAMP
  cancel_reason varchar(255)

  indexes {
  (code) [unique, name: 'uq_menu_orders_code']
  (account_id, created_at) [name: 'idx_menu_orders_account']
  (status, reservation_expires_at, id) [name: 'idx_menu_orders_hold_expiry']
  (store_id, paid_at) [name: 'idx_menu_orders_paid_at']
  (store_id, status, created_at) [name: 'idx_menu_orders_store_status']
  }
}

// Từng món trong yêu cầu gọi món, với tên và giá chụp lúc đặt.
// DDL: sql/007_menu.sql
// CHECK chk_menu_order_items_price: (unit_price between 1000 and 10000000)
// CHECK chk_menu_order_items_quantity: (quantity between 1 and 20)
Table menu_order_items {
  order_id bigint [not null]
  item_id bigint [not null]
  item_name varchar(80) [not null]
  unit_price bigint [not null]
  quantity int [not null]

  indexes {
  (order_id, item_id) [pk]
  }
}

// Nguyên liệu tồn kho theo từng cửa hàng; lượng khả dụng bằng tồn thực tế trừ lượng đã giữ chỗ.
// DDL: sql/013_inventory.sql
// CHECK chk_inventory_ingredients_balance: ((on_hand >= 0) and (reserved >= 0) and (reserved <= on_hand) and (reorder_point >= 0))
// CHECK chk_inventory_ingredients_unit: (unit in ('g','ml','each'))
Table inventory_ingredients {
  id bigint [not null, pk, increment]
  store_id bigint [not null]
  code varchar(32) [not null]
  name varchar(100) [not null]
  unit varchar(4) [not null]
  on_hand bigint [not null, default: 0]
  reserved bigint [not null, default: 0]
  reorder_point bigint [not null, default: 0]
  is_active tinyint(1) [not null, default: 1]

  indexes {
  (store_id, code) [unique, name: 'uq_inventory_ingredients_store_code']
  (store_id, id) [unique, name: 'uq_inventory_ingredients_store_id']
  }
}

// Công thức hiện hành của món có theo dõi kho.
// DDL: sql/013_inventory.sql
// CHECK chk_menu_item_recipes_quantity: (quantity_per_unit > 0)
Table menu_item_recipes {
  item_id bigint [not null]
  ingredient_id bigint [not null]
  quantity_per_unit bigint [not null]

  indexes {
  (item_id, ingredient_id) [pk]
  }
}

// Ảnh chụp nhu cầu nguyên liệu của từng dòng đơn, giúp đổi công thức sau này không làm sai giữ/xuất kho cũ.
// DDL: sql/013_inventory.sql
// CHECK chk_menu_order_recipe_snapshots_quantity: (quantity > 0)
Table menu_order_recipe_snapshots {
  order_id bigint [not null]
  item_id bigint [not null]
  ingredient_id bigint [not null]
  quantity bigint [not null]

  indexes {
  (order_id, item_id, ingredient_id) [pk]
  }
}

// Sổ cái kho bất biến: nhập, giữ chỗ, hoàn giữ chỗ, tiêu thụ, hao hụt, trả và điều chỉnh.
// DDL: sql/013_inventory.sql
// CHECK chk_inventory_movements_kind: (kind in ('RECEIVE','RESERVE','RELEASE','CONSUME','WASTE','RETURN','ADJUST','ISSUE'))
// CHECK chk_inventory_movements_quantity: (quantity > 0)
Table inventory_movements {
  id bigint [not null, pk, increment]
  store_id bigint [not null]
  ingredient_id bigint [not null]
  order_id bigint
  employee_id bigint
  account_id bigint
  kind varchar(10) [not null]
  quantity bigint [not null]
  on_hand_delta bigint [not null, default: 0]
  reserved_delta bigint [not null, default: 0]
  idempotency_key varchar(100) [not null]
  reference_code varchar(60)
  note varchar(255)
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
  (idempotency_key) [unique, name: 'uq_inventory_movements_key']
  (ingredient_id, id) [name: 'idx_inventory_movements_ingredient_id']
  (store_id, created_at, id) [name: 'idx_inventory_movements_store_time']
  }
}

// Phiếu kiểm kê đề xuất; người khác có thẩm quyền phải phê duyệt trước khi tạo điều chỉnh kho.
// DDL: sql/014_inventory_counting.sql
// CHECK chk_inventory_counts_quantities: ((expected_on_hand >= 0) and (expected_reserved >= 0) and (counted_on_hand >= 0))
// CHECK chk_inventory_counts_status: (status in ('PENDING','APPROVED','REJECTED'))
Table inventory_counts {
  id bigint [not null, pk, increment]
  store_id bigint [not null]
  ingredient_id bigint [not null]
  request_id char(32) [not null]
  expected_on_hand bigint [not null]
  expected_reserved bigint [not null]
  expected_movement_id bigint [not null]
  counted_on_hand bigint [not null]
  proposed_by bigint [not null]
  decided_by bigint
  status varchar(10) [not null, default: 'PENDING']
  reason varchar(255) [not null]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  decided_at datetime

  indexes {
  (request_id) [unique, name: 'uq_inventory_counts_request']
  (store_id, status, created_at, id) [name: 'idx_inventory_counts_store_status']
  }
}

// Sổ sự kiện thông báo bền vững cho khách theo vòng đời đơn; khóa sự kiện chống phát trùng.
// DDL: sql/015_menu_order_notifications.sql
Table customer_notification_events {
  id bigint [not null, pk, increment]
  notification_key varchar(100) [not null]
  account_id bigint [not null]
  store_id bigint [not null]
  kind varchar(40) [not null]
  code varchar(20) [not null]
  amount int [not null, default: 0]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
  (notification_key) [unique, name: 'uq_customer_notification_event_key']
  (account_id, created_at, id) [name: 'idx_customer_notification_account_created']
  }
}

// Yêu cầu hoàn/hủy toàn bộ đơn POS có maker-checker và quyết định hoàn kho hoặc ghi hao hụt.
// DDL: sql/018_pos_reversals.sql
// CHECK chk_pos_reversal_decision: (((status = 'PENDING') and (decided_by is null) and (decided_at is null)) or ((status <> 'PENDING') and (decided_by is not null) and (decided_at is not null)))
// CHECK chk_pos_reversal_disposition: (disposition in ('RESTOCK','WASTE'))
// CHECK chk_pos_reversal_method: ((refund_method is null) or (refund_method in ('CASH','TRANSFER')))
// CHECK chk_pos_reversal_status: (status in ('PENDING','APPROVED','REJECTED'))
Table pos_order_reversals {
  id bigint [not null, pk, increment]
  order_id bigint [not null]
  store_id bigint [not null]
  requested_by bigint [not null]
  reason varchar(255) [not null]
  disposition varchar(8) [not null]
  status varchar(10) [not null, default: 'PENDING']
  decided_by bigint
  decided_at datetime
  refund_amount bigint [not null, default: 0]
  refund_method varchar(10)
  refund_reference varchar(100)
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
  (order_id) [unique, name: 'uq_pos_reversal_order']
  (store_id, status, id) [name: 'idx_pos_reversal_store_status']
  }
}

// Chính sách khuyến mãi POS theo cơ sở; mỗi đơn chỉ chọn một ưu đãi xác định.
// DDL: sql/019_pos_promotions.sql
// CHECK chk_menu_promo_kind: (kind in ('BOGO','PLAY_DRINK','TIER_PERCENT'))
// CHECK chk_menu_promo_period: (starts_at < ends_at)
// CHECK chk_menu_promo_tier: ((minimum_tier is null) or (minimum_tier in ('BRONZE','SILVER','GOLD','PLATINUM')))
Table menu_promotions {
  id bigint [not null, pk, increment]
  store_id bigint [not null]
  code varchar(30) [not null]
  kind varchar(16) [not null]
  item_id bigint
  value int [not null]
  minimum_tier varchar(12)
  starts_at datetime [not null]
  ends_at datetime [not null]
  is_active tinyint(1) [not null, default: 0]

  indexes {
  (store_id, code) [unique, name: 'uq_menu_promo_store_code']
  (store_id, is_active, starts_at, ends_at) [name: 'idx_menu_promo_active']
  }
}

// Snapshot kết quả tính giá POS bất biến tại thời điểm đặt/thanh toán.
// DDL: sql/019_pos_promotions.sql
Table menu_order_pricing {
  order_id bigint [not null, pk]
  promotion_id bigint
  promotion_code varchar(30)
  promotion_kind varchar(16)
  discount_amount bigint [not null, default: 0]
  final_amount bigint [not null]
  snapshot_json json [not null]
}

// Danh mục phần thưởng; không có loại nào quy đổi tiền mặt.
// DDL: sql/008_vouchers.sql
// CHECK chk_reward_catalog_coin: ((coin_cost is null) or (coin_cost between 1 and 1000000))
// CHECK chk_reward_catalog_days: (valid_days between 1 and 365)
// CHECK chk_reward_catalog_min_order: (min_order_amount between 0 and 10000000)
// CHECK chk_reward_catalog_name: (char_length(trim(name)) > 0)
// CHECK chk_reward_catalog_type: (reward_type in ('FOOD_DISCOUNT','FREE_DRINK','PLAYTIME_CREDIT','MEMBER_POINTS'))
// CHECK chk_reward_catalog_value: (value between 1 and 1000000)
Table reward_catalog {
  id bigint [not null, pk, increment]
  code varchar(20) [not null]
  name varchar(80) [not null]
  store_id bigint
  reward_type varchar(20) [not null]
  value bigint [not null]
  min_order_amount bigint [not null, default: 0]
  valid_days int [not null]
  coin_cost bigint
  is_active tinyint(1) [not null, default: 1]
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
  (code) [unique, name: 'uq_reward_catalog_code']
  }
}

// Voucher của khách; điều kiện được chụp lúc phát, dùng một lần.
// DDL: sql/008_vouchers.sql
// CHECK chk_customer_vouchers_period: (expires_at > issued_at)
// CHECK chk_customer_vouchers_source: (source in ('MANUAL','GAME','AD'))
// CHECK chk_customer_vouchers_status: (status in ('ISSUED','USED','REVOKED'))
// CHECK chk_customer_vouchers_type: (reward_type in ('FOOD_DISCOUNT','FREE_DRINK','PLAYTIME_CREDIT','MEMBER_POINTS'))
// CHECK chk_customer_vouchers_used: (((status = 'USED') and (used_at is not null) and (used_by is not null) and (used_store_id is not null)) or ((status <> 'USED') and (used_at is null) and (used_by is null) and (used_order_id is null)))
// CHECK chk_customer_vouchers_value: (value between 1 and 1000000)
Table customer_vouchers {
  id bigint [not null, pk, increment]
  code varchar(20) [not null]
  catalog_id bigint [not null]
  account_id bigint [not null]
  store_id bigint
  reward_type varchar(20) [not null]
  value bigint [not null]
  min_order_amount bigint [not null, default: 0]
  status varchar(10) [not null, default: 'ISSUED']
  source varchar(10) [not null]
  source_ref varchar(64)
  issued_by bigint
  issued_at datetime [not null, default: `CURRENT_TIMESTAMP`]
  expires_at datetime [not null]
  used_at datetime
  used_by bigint
  used_store_id bigint
  used_order_id bigint
  revoked_reason varchar(200)

  indexes {
  (code) [unique, name: 'uq_customer_vouchers_code']
  (used_order_id) [unique, name: 'uq_customer_vouchers_order']
  (source, source_ref) [unique, name: 'uq_customer_vouchers_source']
  (account_id, status, expires_at) [name: 'idx_customer_vouchers_account']
  }
}

// Nhật ký phát hành, sử dụng, khóa và cả lần bị từ chối; chỉ thêm.
// DDL: sql/008_vouchers.sql
// CHECK chk_voucher_events_action: (action in ('ISSUE','REDEEM','REVOKE','REJECT'))
Table voucher_events {
