  voucher_id bigint
  action varchar(10) [not null]
  employee_id bigint
  store_id bigint
  reason varchar(200) [not null, default: '']
  created_at datetime [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
  (store_id, created_at) [name: 'idx_voucher_events_store']
  (voucher_id, created_at) [name: 'idx_voucher_events_voucher']
  }
}

// Điểm thành viên tặng qua voucher; cộng vào điểm, không đổi hạng.
// DDL: sql/008_vouchers.sql
