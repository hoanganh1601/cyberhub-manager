// CHECK chk_game_coin_ledger_balance: (balance_after >= 0)
// CHECK chk_game_coin_ledger_delta: (delta <> 0)
// CHECK chk_game_coin_ledger_reason: (reason in ('PLAY','REDEEM','AD','ADJUST'))
Table game_coin_ledger {
